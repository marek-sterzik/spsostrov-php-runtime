{% extends "base.html.twig" %}
{% block body %}
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-6 col-12">
                <div>
                    <h1>{{ assignment.caption }}</h1>
                    {{ descriptionHtml|raw }}
                </div>
                <table class="table table-bordered thin-headings">
                    <tr><th>třídy:</th><td>{{ studentClassPattern.render()|raw }}</td></tr>
                    <tr><th>typ:</th><td>{% include "snippets/assignment-public.html.twig" with {"public": assignment.public} %}</td></tr>
                    <tr><th>stav:</th><td>{% include "snippets/assignment-state.html.twig" with {"state": assignment.state} %}</td></tr>
                    {% include "snippets/deadlines.html.twig" with {"assignment": assignment} %}
                    <tr><th>odevzdávání:</th><td>{{ assignment.submissionMode.description }}</td></tr>
                    <tr><th>zálohování:</th><td>{% include "snippets/backed-up.html.twig" with {"backedUp": assignment.backedUp} %}</td></tr>
                    <tr><th>nedokončená&nbsp;odevzdání:</th><td>{{ assignment.missedDraftPolicy.description }}</td></tr>
                    <tr><th>vlastník:</th><td>{{ assignment.owner.name }} {% if ownerIsMe %}{% include "snippets/me.html.twig" %}{% endif %}</td></tr>
                    <tr><th>školní rok:</th><td>{{ assignment.schoolYear }}/{{ assignment.schoolYear + 1 }}</td></tr>
                    <tr><th>vytvořeno:</th><td>{% include "snippets/datetime.html.twig" with {"date": assignment.createdAt} %}</td></tr>
                        {% if submissionCount is not null %}
                        <tr><th>počet&nbsp;odevzdání:</th><td>
                                {% include "snippets/object-count.html.twig" with {"count": submissionCount, "link": submissionsLink} %}
                                {% if submissionsLink is not null %}
                                    <a href="{{ submissionsLink }}">zobrazit odevzdané práce</a>
                                {% endif %}
                        </td></tr>
                    {% endif %}
                    <tr><td colspan="2">
                        {% for action in actions %}{{ action.render()|raw }} {% endfor %}
                    </td></tr>
                </table>
            </div>
        </div>
    </div>
{% endblock %}

