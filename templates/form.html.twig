{% extends "base.html.twig" %}
{% block body %}
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-6 col-12">
                {% if caption is not null %}
                    <h3>{{ caption }}</h3>
                {% endif %}
                {% block before_form_hook %}{% endblock %} 
                {% block form %}
                    {{ form(form) }}
                {% endblock %}
                {% block after_form_hook %}{% endblock %} 
            </div>
        </div>
    </div>
{% endblock %}
