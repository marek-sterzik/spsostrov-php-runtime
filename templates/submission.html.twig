{% extends "base.html.twig" %}
{% block body %}
    {{ backAction.render()|raw }}
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-6 col-12">
                <h3>{{ heading }}</h3>
                {% if not submission.state.isFinal() %}
                    <div class="alert alert-warning submission-not-final" role="alert" data-submission-state-update-timeout="{{ timeout }}"
                          data-submission-state-update="{{ path("submission-detail", {"submission": submission.id,"state": 1}) }}">
                        <div class="text-center">
                            <div class="spinner-border text-primary" role="status"></div>
                        </div>
                        <div class="mt-3 text-center">
                            {% if submission.assignment.backedUp %}
                                Vyčkejte prosím, až se odevzdání zpracuje a zálohuje.
                            {% else %}
                                Vyčkejte prosím, až se odevzdání zpracuje.
                            {% endif %}
                            U velkých souborů může tato operace trvat i několik minut.
                        </div>
                    </div>
                {% endif %}
                <h4>Informace</h4>
                <table class="table table-bordered thin-headings">
                    <tr><th>stav:</th><td class="submission-state">{% include "snippets/submission-state.html.twig" with {"state": submission.state, "isCurrent": submission.isCurrent} %}</td></tr>
                    <tr><th>odevzdal:</th><td>{{ submission.submitter.name }}{% if submission.submitter == userEntity %} {% include "snippets/me.html.twig" %}{% endif %}</td></tr>
                    {% if submission.submittedAt is not null %}
                        <tr><th>čas&nbsp;odevzdání:</th><td>{% include "snippets/submitted-at.html.twig" with {"submission": submission} %}</td></tr>
                    {% endif %}
                </table>
                {% if files is not empty %}
                    <h4>Soubory</h4>
                    <ul class="list-group mb-3">
                        {% for file in files %}
                            <li class="list-group-item hscroll">
                                <div class="submitted-file-show">
                                    <div class="submitted-file text-nowrap">
                                        <span class="badge rounded-pill bg-secondary submitted-file-size">{{ file.byteCountFormatted }}</span>
                                        <a href="{{ path("submission-files", {"submission": submission.id, "file": file.filename}) }}"
                                           class="font-monospace text-black file-link"
                                           target="_blank"
                                        >{{ file.filename }}</a>
                                    </div>
                                </div>
                            </li>
                        {% endfor %}
                    </ul>
                    <div class="zip-file">
                        {% if zipFile is not null %}
                            {% include "snippets/zip-file.html.twig" with {"zipFile": zipFile} %}
                        {% endif %}
                    </div>
                {% else %}
                    <div class="alert alert-warning" role="alert">
                        <strong>Varování:</strong> Soubory z tohoto odevzdání chybí. Patrně byly vymazány z hlavního uložiště.
                        {% if submission.state.isSynced() %}
                            Data ale mohou být uložena na záložním uložišti. Kontaktujte prosím správce aplikace, pokud potřebujete data
                            přesto získat.
                        {% else %}
                            Data přitom nejsou uložena na záložním uložišti, proto již není možné je získat skrze tuto aplikaci.
                        {% endif %}
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}

