{% extends "base.html.twig" %}
{% block nav %}
    {% if previousSubmissionLink is not null or nextSubmissionLink is not null %}
        <div class="float-end">
            <div class="btn-group" role="group" aria-label="Basic example">
                {% if previousSubmissionLink is not null %}<a class="btn btn-sm btn-secondary" role="button" href="{{ previousSubmissionLink }}"><i class="bi me-1 bi-arrow-left"></i></a>{% endif %}
                {% if nextSubmissionLink is not null %}<a class="btn btn-sm btn-secondary" role="button" href="{{ nextSubmissionLink }}"><i class="bi me-1 bi-arrow-right"></i></a>{% endif %}
            </div>
        </div>
    {% endif %}
{% endblock %}
{% block body %}
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-6 col-12">
                <h3>{{ heading }}</h3>
                {% if submission.state.isWaiting() %}
                    <div class="alert alert-warning submission-not-final" role="alert" data-submission-state-update-timeout="{{ timeout }}"
                          data-submission-state-update="{{ path("submission-detail", {"submission": submission.id,"state": 1}) }}">
                        <div class="text-center">
                            <div class="spinner-border text-primary" role="status"></div>
                        </div>
                        <div class="mt-3 text-center">
                            {% if submission.assignment.backedUp %}
                                Vyčkejte prosím, až se odevzdání zpracuje a zálohuje.
                            {% else %}
                                Vyčkejte prosím, až se odevzdání zpracuje.
                            {% endif %}
                            U velkých souborů může tato operace trvat i několik minut.
                        </div>
                    </div>
                {% endif %}
                {% if versionInfo is not null and not versionInfo.current.isCurrent %}
                    <div class="alert alert-warning" role="alert">
                        <strong>Varování:</strong> Toto je starší verze odevzdané práce. Byla odevzdána novější verze.
                    </div>
                {% endif %}
                <h4>Informace</h4>
                <table class="table table-bordered thin-headings">
                    <tr><th>stav:</th><td class="submission-state">{% include "snippets/submission-state.html.twig" with {"state": submission.state, "isCurrent": submission.isCurrent} %}</td></tr>
                    {% if versionInfo is not null %}
                        <tr><th class="align-middle">verze:</th><td>
                            <div class="dropdown">
                                <button class="btn btn-sm {% if versionInfo.current.isCurrent %}btn-primary{% else %}btn-secondary{% endif %}
                                        dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    {{ versionInfo.current.version }} {% if versionInfo.current.isCurrent %}(aktuální){% else %}(starší){% endif %}
                                </button>
                                <ul class="dropdown-menu">
                                    {% for version in versionInfo.versions %}
                                        <li><a class="dropdown-item" href="{{ version.link }}">{{ version.version }} {% if version.isCurrent %} (aktuální){% endif %}</a></li>
                                    {% endfor %}
                                </ul>
                            </div>
                        </td></tr>
                    {% endif %}
                    <tr><th>odevzdal:</th><td>{{ submission.submitter.name }}{% if submission.submitter == userEntity %} {% include "snippets/me.html.twig" %}{% endif %}</td></tr>
                    {% if submission.submittedAt is not null %}
                        <tr><th>čas&nbsp;odevzdání:</th><td>{% include "snippets/submitted-at.html.twig" with {"submission": submission} %}</td></tr>
                    {% endif %}
                </table>
                {% if files is not empty %}
                    <h4>Soubory</h4>
                    <ul class="list-group mb-3">
                        {% for file in files %}
                            <li class="list-group-item hscroll">
                                <div class="submitted-file-show">
                                    <div class="submitted-file text-nowrap">
                                        <span class="badge rounded-pill bg-secondary submitted-file-size">{{ file.byteCountFormatted }}</span>
                                        <a href="{{ path("submission-files", {"submission": submission.id, "file": file.filename}) }}"
                                           class="font-monospace text-black file-link"
                                           target="_blank"
                                        >{{ file.filename }}</a>
                                    </div>
                                </div>
                            </li>
                        {% endfor %}
                    </ul>
                    <div class="zip-file">
                        {% if zipFile is not null %}
                            {% include "snippets/zip-file.html.twig" with {"zipFile": zipFile} %}
                        {% endif %}
                    </div>
                {% else %}
                    <div class="alert alert-warning" role="alert">
                        <strong>Varování:</strong> Soubory z tohoto odevzdání chybí. Patrně byly vymazány z hlavního uložiště.
                        {% if submission.state.isSynced() %}
                            Data ale mohou být uložena na záložním uložišti. Kontaktujte prosím správce aplikace, pokud potřebujete data
                            přesto získat.
                        {% else %}
                            Data přitom nejsou uložena na záložním uložišti, proto již není možné je získat skrze tuto aplikaci.
                        {% endif %}
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}

