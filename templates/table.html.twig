{% extends "base.html.twig" %}
{% macro paginator(paginator) %}
    {% if paginator is not empty %}
        <ul class="pagination pagination-sm justify-content-center">
            {% for page in paginator %}
                <li class="page-item{% if page.skip %} ms-3{% endif %}{% if page.active %} active{% endif %}">
                    <a class="page-link{% if page.disabled %} disabled{% endif %}" href="{{ page.link }}" aria-label="{{ page.label }}">
                        {% if page.type == 'prev' %}
                            <span aria-hidden="true">&laquo;</span>
                        {% elseif page.type == 'next' %}
                            <span aria-hidden="true">&raquo;</span>
                        {% elseif page.type == 'normal' %}
                            {{ page.label }}
                        {% else %}
                            ?
                        {% endif %}
                    </a>
                </li>
            {% endfor %}
        </ul>
    {% endif %}
{% endmacro %}
{% block body %}
    {% block body_start_hook %}{% endblock %}
    {% if _tableData.form is defined and _tableData.form is not null %}
        {{ form(_tableData.form) }}
    {% endif %}

    {{ _self.paginator(_tableData.table.paginator) }}
    {% if _tableData.table.body is empty %}
        <div class="text-center">žádná data</div>
    {% else %}
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>{% for h in _tableData.table.header %}{{ h.render("th")|raw }}{% endfor %}</tr>
        </thead>
        <tbody>
            {% for row in _tableData.table.body %}
                <tr>{% for c in row %}{{ c.render("td")|raw }}{% endfor %}</tr>
            {% endfor %}
        </tbody>
    </table>
    {{ _self.paginator(_tableData.table.paginator) }}
    {% endif %}
{% endblock %}
