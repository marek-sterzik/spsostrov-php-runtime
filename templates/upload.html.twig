{% extends "form.html.twig" %}
{% block form %}
    <div class="card">
        <div class="card-body">
            {{ form(form) }}
        </div>
    </div>
{% endblock %}

{% block before_form_hook %}
    {% if files|length > 0 %}
    <div class="alert alert-danger" role="alert">
        <strong>Pozor:</strong> Odevzdání není kompletní, dokud nebude uzavřeno.
        <div class="text-center mt-3">
                <a class="btn btn-danger" role="button" href="#">uzavřít a odevzdat</a>
        </div>
    </div>
    <ul class="list-group mb-3">
        {% for file in files %}
            <li class="submitted-file-item list-group-item">
                <a href="#" class="submitted-file-left bi bi-caret-left-fill text-primary"></a>
                <a href="#" class="submitted-file-right bi bi-caret-right-fill text-primary"></a>
                <div class="submitted-file overflow-auto font-monospace text-nowrap">{{ file.filename }}</div>
            </li>
        {% endfor %}
    </ul>
    {% endif %}
    
{% endblock %}
